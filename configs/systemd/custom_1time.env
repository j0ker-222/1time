# /etc/custom_1time/env  (chmod 600, owner root)
LISTEN_ADDR=127.0.0.1:8080
# host:port or an absolute path to a unix socket
REDISHOST=127.0.0.1:6379
# Same value as requirepass in /etc/redis/1time.conf
REDISPASS=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
REDISDB=0

# Storage: redis (default, one server) or postgres (several servers,
# see deploy/ha/README.md). With postgres the REDIS* lines are ignored.
#STORE=postgres
#DATABASE_URL=postgres://onetime:PASSWORD@127.0.0.1:5432/onetime?sslmode=disable
#PG_MAX_CONNS=10
#DB_MIGRATE=true
#CLEANUP_INTERVAL=10m
