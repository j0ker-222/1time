# /etc/custom_1time/env on app1 and app2 (chmod 600, owner root).
# Each node listens on its own private address, only lb1/lb2 may connect.
LISTEN_ADDR=10.10.0.21:8080          # app2: 10.10.0.22:8080

STORE=postgres
# Both PostgreSQL nodes are listed. target_session_attrs=read-write makes
# every new connection go to the current primary, so after a database
# failover the application follows without a restart.
DATABASE_URL=postgres://onetime:CHANGE_ME@10.10.0.21:5432,10.10.0.22:5432/onetime?target_session_attrs=read-write&sslmode=prefer&connect_timeout=3
PG_MAX_CONNS=10
# Create the table on start (needs CREATE rights; set false if the schema
# is applied by hand from deploy/ha/postgresql/schema.sql).
DB_MIGRATE=true
# How often expired messages are deleted (0 disables). Safe on both nodes.
CLEANUP_INTERVAL=10m
